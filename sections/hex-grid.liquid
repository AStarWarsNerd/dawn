{{ 'hex-grid.css' | asset_url | stylesheet_tag }}

{%- assign id = '#shopify-section-' | append: section.id -%}

<style>
  {{ id }} .hex-grid-container {
      background-color: {{ section.settings.background_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {{ id }} .hex-grid-container h2,
  {{ id }} .hex-grid-container .content {
      color: {{ section.settings.heading_color }};
  }
  {{ id }} .grid-hex-outer {
      background-color: {{ section.settings.hex_background_color }};
  }
  {{ id }} .grid-hex {
      background-color: {{ section.settings.background_color }};
  }
  {{ id }} .grid-hex h3 {
      color: {{ section.settings.hex_title_color }};
      max-width: 85%;
      margin: 0 auto;
  }
  {{ id }} .grid-hex-inner {
      background-color: {{ section.settings.hex_background_color }};
      color: {{ section.settings.hex_text_color }};
  }
  {{ id }} .title-hex .price {
      color: {{ section.settings.hex_text_color }};
  }
  {{ id }} .title-hex .hex-button {
      background-color: {{ section.settings.hex_button_color }};
  }
  {{ id }} .title-hex .hex-button:hover {
      background-color: {{ section.settings.hex_button_hover_color }};
  }
</style>

<div class="hex-grid-container hex-grid">
  <div class="page-width page-width-desktop">
    {% if section.settings.title != null %}
      <div class="hex-title-row">
        <h2>{{ section.settings.title }}</h2>
        {% if section.settings.content != null %}
          <div class="content">{{ section.settings.content }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="grid-hex-rows">
      {% if section.blocks.size > 0 %}
        <div class="grid-hex-row">
          {% for block in section.blocks %}
            <div class="grid-hex-outer">
              <div class="grid-hex title-hex">
                <div class="grid-hex-inner">
                  <img
                    src="{{ block.settings.hex_image | img_url: 'medium' }}"
                    alt="{{ block.settings.hex_text }}"
                    width="100"
                    height="100"
                  >

                  <h3>{{ block.settings.hex_text }}</h3>
                </div>
              </div>
            </div>

            {% assign remainder = forloop.index | modulo: 5 %}
            {% if forloop.index < section.blocks.size %}
              {% if remainder == 0 %}
                </div>
                <div class="grid-hex-row">
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if remainder == 1 %}
            <div></div>
            <div></div>
            <div></div>
            <div></div>
          {% elsif remainder == 2 %}
            <div></div>
            <div></div>
            <div></div>
          {% elsif remainder == 3 %}
            <div></div>
            <div></div>
          {% elsif remainder == 4 %}
            <div></div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

