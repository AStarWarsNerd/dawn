{{ 'product-hexes.css' | asset_url | stylesheet_tag }}

{%- assign id = '#shopify-section-' | append: section.id -%}

<style>
  {{ id }} .product-hexes-container {
      background-color: {{ section.settings.background_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {{ id }} .product-hexes-container h2 {
      color: {{ section.settings.heading_color }};
  }
  {{ id }} .product-hex-outer {
      background-color: {{ section.settings.hex_background_color }};
  }
  {{ id }} .product-hex {
      background-color: {{ section.settings.background_color }};
  }
  {{ id }} .product-hex h3 {
      color: {{ section.settings.hex_title_color }};
  }
  {{ id }} .product-hex-inner {
      background-color: {{ section.settings.hex_background_color }};
      color: {{ section.settings.hex_text_color }};
  }
  {{ id }} .title-hex .price {
      color: {{ section.settings.hex_text_color }};
  }
  {{ id }} .title-hex .hex-button {
      background-color: {{ section.settings.hex_button_color }};
  }
  {{ id }} .title-hex .hex-button:hover {
      background-color: {{ section.settings.hex_button_hover_color }};
  }
</style>

<div class="product-hexes-container product-listing-hexes">
  <div class="page-width page-width-desktop">
    {% if section.settings.title != null %}
      <div class="hex-title-row">
        <h2>{{ section.settings.title }}</h2>
        {% if section.settings.button_text != '' %}
          <div class="hex-button-container">
            <a href="{{ section.settings.button_link }}" class="hex-button">{{ section.settings.button_text }}</a>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="product-hex-rows">
      {% if section.settings.collection.products.size > 0 %}
        <div class="product-hex-row">
          {% for product in section.settings.collection.products %}
            <div class="product-hex-outer">
              <div class="product-hex title-hex">
                <div class="product-hex-inner">
                  <a href="{{ product.url}}">
                    <img
                      src="{{ product.featured_image | img_url: 'medium' }}"
                      alt="{{ product.title }}"
                      width="200"
                      height="200"
                    >
                  </a>

                  <a href="{{ product.url}}">
                    <h3>{{ product.title }}</h3>
                  </a>

                  <p class="price">{{ product.price | money }}</p>

                  {% if product.variants.size > 1 %}
                    <a href="{{ product.url }}" class="hex-button">View Options</a>
                  {% else %}
                    <form method="post" action="/cart/add">
                      <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                      <button type="submit" class="hex-button">Add to Cart</button>
                    </form>
                  {% endif %}
                </div>
              </div>
            </div>

            {% assign remainder = forloop.index | modulo: 3 %}
            {% if forloop.index < section.settings.collection.products.size %}
              {% if remainder == 0 %}
                </div>
                <div class="product-hex-row">
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if remainder == 1 %}
            <div></div>
            <div></div>
          {% endif %}
          {% if remainder == 2 %}
            <div></div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

