{%- assign id = '#shopify-section-' | append: section.id -%}

<style>
  {{ id }} .title-with-content {
      background-color: {{ section.settings.background_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {{ id }} .title-with-content .page-width {
      text-align: center;
  }
  {{ id }} .title-with-content h1 {
      color: {{ section.settings.heading_color }};
  }
  {{ id }} .title-with-content .content {
      color: {{ section.settings.content_color }};
      max-width: 600px;
      margin: 0 auto;
      font-size: 20px;
  }

  @media screen and (max-width: 750px) {
    {{ id }} .title-with-content .content {
      padding: 0 10px;
      font-size: 18px;
      line-height: 28px;
    }
  }
</style>

<div class="title-with-content">
  <div class="page-width page-width-desktop">
    {% if section.settings.title != null %}
      <h1>{{ section.settings.title }}</h1>
    {% endif %}

    {% if section.settings.content != null %}
      <div class="content">{{ section.settings.content }}</div>
    {% endif %}
  </div>
</div>

