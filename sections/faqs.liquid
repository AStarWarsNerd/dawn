{{ 'faqs.css' | asset_url | stylesheet_tag }}

{%- assign id = '#shopify-section-' | append: section.id -%}

<style>
  {{ id }} .faq-container {
      background-color: {{ section.settings.background_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {{ id }} .faq-container h2,
  {{ id }} .faq-container .content {
    color: {{ section.settings.heading_color }};
  }
  {{ id }} .faq summary {
    background-color: {{ section.settings.question_background_color }};
    color: {{ section.settings.question_color }};
  }
  {{ id }} .faq .answer {
    background-color: {{ section.settings.answer_background_color }};
    color: {{ section.settings.answer_color }};
    border-top: 1px solid {{ section.settings.answer_color }};
  }
</style>

<div class="faq-container">
  <div class="page-width page-width-desktop">
    {% if section.settings.title != null %}
      <div class="hex-title-row">
        <h2>{{ section.settings.title }}</h2>
        {% if section.settings.content != null %}
          <div class="content">{{ section.settings.content }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="faqs">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="faq">
            <details>
              <summary>
                {{ block.settings.question_text -}}
                <span></span>
              </summary>
              <p class="answer">{{ block.settings.answer_text }}</p>
            </details>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

